{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./backend_dist",
    "rootDir": "./backend_src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["backend_src/**/*"],
  "exclude": ["backend_src/index_utf8.ts"]
}
